{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "group:allNonMajor"],
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "postUpdateOptions": ["gomodTidy", "pnpmDedupe"],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "groupName": "go dependencies"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "npm dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "pinDigests": false
    },
    {
      "matchPackageNames": ["github.com/wailsapp/wails/v3", "@wailsio/runtime"],
      "groupName": "wails",
      "description": "Keep the Go framework and its JS runtime on the same version."
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
