{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rnlens.dev/schema/lens-protocol/v1",
  "title": "LensMessage",
  "description": "Every frame exchanged between @rnlens/sdk and Lens over the SDK WebSocket. Protocol version 1.",
  "oneOf": [
    {
      "$ref": "#/$defs/HelloMessage"
    },
    {
      "$ref": "#/$defs/QueriesSnapshotMessage"
    },
    {
      "$ref": "#/$defs/QueryEventMessage"
    },
    {
      "$ref": "#/$defs/MutationEventMessage"
    },
    {
      "$ref": "#/$defs/OnlineStatusMessage"
    },
    {
      "$ref": "#/$defs/ActionResultMessage"
    },
    {
      "$ref": "#/$defs/PongMessage"
    },
    {
      "$ref": "#/$defs/WelcomeMessage"
    },
    {
      "$ref": "#/$defs/SnapshotRequestMessage"
    },
    {
      "$ref": "#/$defs/QueryActionMessage"
    },
    {
      "$ref": "#/$defs/OnlineSetMessage"
    },
    {
      "$ref": "#/$defs/PingMessage"
    },
    {
      "$ref": "#/$defs/StorageSnapshotMessage"
    },
    {
      "$ref": "#/$defs/StorageEventMessage"
    },
    {
      "$ref": "#/$defs/StorageActionMessage"
    },
    {
      "$ref": "#/$defs/StorageResultMessage"
    },
    {
      "$ref": "#/$defs/PluginRegisterMessage"
    },
    {
      "$ref": "#/$defs/PluginViewMessage"
    },
    {
      "$ref": "#/$defs/PluginActionMessage"
    },
    {
      "$ref": "#/$defs/PluginResultMessage"
    }
  ],
  "$defs": {
    "JsonValue": {
      "title": "JsonValue",
      "description": "Any JSON value (object, array, string, number, boolean or null).",
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "array"
        },
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "QueryKey": {
      "title": "QueryKey",
      "type": "array",
      "description": "TanStack Query key: an array of JSON values.",
      "items": {
        "$ref": "#/$defs/JsonValue"
      }
    },
    "QueryStatus": {
      "title": "QueryStatus",
      "type": "string",
      "enum": ["pending", "error", "success"]
    },
    "FetchStatus": {
      "title": "FetchStatus",
      "type": "string",
      "enum": ["fetching", "paused", "idle"]
    },
    "MutationStatus": {
      "title": "MutationStatus",
      "type": "string",
      "enum": ["idle", "pending", "success", "error"]
    },
    "QueryState": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/QueryStatus"
        },
        "fetchStatus": {
          "$ref": "#/$defs/FetchStatus"
        },
        "dataUpdatedAt": {
          "type": "number",
          "description": "Milliseconds since epoch; 0 when never updated."
        },
        "errorUpdatedAt": {
          "type": "number"
        },
        "dataUpdateCount": {
          "type": "integer",
          "minimum": 0
        },
        "errorUpdateCount": {
          "type": "integer",
          "minimum": 0
        },
        "fetchFailureCount": {
          "type": "integer",
          "minimum": 0
        },
        "isInvalidated": {
          "type": "boolean"
        },
        "data": {
          "$ref": "#/$defs/JsonValue"
        },
        "error": {
          "$ref": "#/$defs/JsonValue"
        },
        "fetchMeta": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "status",
        "fetchStatus",
        "dataUpdatedAt",
        "errorUpdatedAt",
        "dataUpdateCount",
        "errorUpdateCount",
        "fetchFailureCount",
        "isInvalidated"
      ],
      "additionalProperties": false,
      "title": "QueryState"
    },
    "Query": {
      "type": "object",
      "properties": {
        "queryHash": {
          "type": "string",
          "description": "Stable hash of the key, as TanStack computes it."
        },
        "queryKey": {
          "$ref": "#/$defs/QueryKey"
        },
        "state": {
          "$ref": "#/$defs/QueryState"
        },
        "observersCount": {
          "type": "integer",
          "minimum": 0
        },
        "isActive": {
          "type": "boolean",
          "description": "At least one enabled observer."
        },
        "isStale": {
          "type": "boolean",
          "description": "As computed on the device with the observers' staleTime."
        },
        "gcTime": {
          "type": "number",
          "description": "Milliseconds; Infinity is sent as -1."
        },
        "meta": {
          "$ref": "#/$defs/JsonValue"
        },
        "dataTruncated": {
          "type": "boolean",
          "description": "data was cut at the SDK's size cap."
        }
      },
      "required": ["queryHash", "queryKey", "state", "observersCount", "isActive", "isStale"],
      "additionalProperties": false,
      "title": "Query"
    },
    "QueryStateDelta": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/QueryStatus"
        },
        "fetchStatus": {
          "$ref": "#/$defs/FetchStatus"
        },
        "dataUpdatedAt": {
          "type": "number",
          "description": "Milliseconds since epoch; 0 when never updated."
        },
        "errorUpdatedAt": {
          "type": "number"
        },
        "dataUpdateCount": {
          "type": "integer",
          "minimum": 0
        },
        "errorUpdateCount": {
          "type": "integer",
          "minimum": 0
        },
        "fetchFailureCount": {
          "type": "integer",
          "minimum": 0
        },
        "isInvalidated": {
          "type": "boolean"
        },
        "data": {
          "$ref": "#/$defs/JsonValue"
        },
        "error": {
          "$ref": "#/$defs/JsonValue"
        },
        "fetchMeta": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [],
      "additionalProperties": false,
      "title": "QueryStateDelta",
      "description": "Subset of QueryState fields that changed."
    },
    "MutationState": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/MutationStatus"
        },
        "submittedAt": {
          "type": "number"
        },
        "isPaused": {
          "type": "boolean"
        },
        "variables": {
          "$ref": "#/$defs/JsonValue"
        },
        "data": {
          "$ref": "#/$defs/JsonValue"
        },
        "error": {
          "$ref": "#/$defs/JsonValue"
        },
        "failureCount": {
          "type": "integer",
          "minimum": 0
        },
        "failureReason": {
          "$ref": "#/$defs/JsonValue"
        },
        "context": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": ["status", "submittedAt", "isPaused"],
      "additionalProperties": false,
      "title": "MutationState"
    },
    "Mutation": {
      "type": "object",
      "properties": {
        "mutationId": {
          "type": "integer",
          "minimum": 0
        },
        "mutationKey": {
          "$ref": "#/$defs/QueryKey"
        },
        "state": {
          "$ref": "#/$defs/MutationState"
        },
        "scope": {
          "$ref": "#/$defs/JsonValue"
        },
        "meta": {
          "$ref": "#/$defs/JsonValue"
        },
        "dataTruncated": {
          "type": "boolean"
        }
      },
      "required": ["mutationId", "state"],
      "additionalProperties": false,
      "title": "Mutation"
    },
    "AppInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Bundle id or package name."
        },
        "name": {
          "type": "string"
        },
        "platform": {
          "type": "string",
          "enum": ["ios", "android", "web", "macos", "windows", "other"]
        },
        "rnVersion": {
          "type": "string"
        }
      },
      "required": ["id", "platform"],
      "additionalProperties": false,
      "title": "AppInfo"
    },
    "DeviceInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable per install; the SDK persists it."
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["id"],
      "additionalProperties": false,
      "title": "DeviceInfo"
    },
    "HelloPayload": {
      "type": "object",
      "properties": {
        "sdkVersion": {
          "type": "string"
        },
        "protocolVersion": {
          "type": "integer",
          "minimum": 1
        },
        "app": {
          "$ref": "#/$defs/AppInfo"
        },
        "device": {
          "$ref": "#/$defs/DeviceInfo"
        },
        "scriptURL": {
          "type": "string",
          "description": "Metro bundle URL the app loaded, used for diagnostics."
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["queries", "storage", "plugins"]
          },
          "uniqueItems": true
        },
        "token": {
          "type": "string",
          "description": "Pairing token when Lens runs with --sdk-token."
        }
      },
      "required": ["sdkVersion", "protocolVersion", "app", "device", "features"],
      "additionalProperties": false,
      "title": "HelloPayload"
    },
    "WelcomePayload": {
      "type": "object",
      "properties": {
        "lensVersion": {
          "type": "string"
        },
        "protocolVersion": {
          "type": "integer",
          "minimum": 1
        },
        "sessionId": {
          "type": "string"
        }
      },
      "required": ["lensVersion", "protocolVersion", "sessionId"],
      "additionalProperties": false,
      "title": "WelcomePayload"
    },
    "QueriesSnapshotPayload": {
      "type": "object",
      "properties": {
        "queries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Query"
          }
        },
        "mutations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mutation"
          }
        },
        "online": {
          "type": "boolean"
        }
      },
      "required": ["queries", "mutations", "online"],
      "additionalProperties": false,
      "title": "QueriesSnapshotPayload"
    },
    "QueryEventKind": {
      "title": "QueryEventKind",
      "type": "string",
      "enum": ["added", "updated", "removed", "observers"]
    },
    "QueryEventPayload": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/QueryEventKind"
        },
        "queryHash": {
          "type": "string"
        },
        "query": {
          "$ref": "#/$defs/Query"
        },
        "action": {
          "type": "string",
          "description": "TanStack action type for kind=updated (fetch, success, error, setState, invalidate, pause, continue, ...)."
        },
        "delta": {
          "$ref": "#/$defs/QueryStateDelta"
        },
        "observersCount": {
          "type": "integer",
          "minimum": 0
        },
        "isActive": {
          "type": "boolean"
        },
        "isStale": {
          "type": "boolean"
        }
      },
      "required": ["kind", "queryHash"],
      "additionalProperties": false,
      "title": "QueryEventPayload",
      "description": "added: query present. updated: delta present (or query when the action is unknown). removed: hash only. observers: observersCount/isActive/isStale present."
    },
    "MutationEventKind": {
      "title": "MutationEventKind",
      "type": "string",
      "enum": ["added", "updated", "removed"]
    },
    "MutationEventPayload": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/MutationEventKind"
        },
        "mutationId": {
          "type": "integer",
          "minimum": 0
        },
        "mutation": {
          "$ref": "#/$defs/Mutation"
        },
        "delta": {
          "type": "object",
          "properties": {
            "status": {
              "$ref": "#/$defs/MutationStatus"
            },
            "submittedAt": {
              "type": "number"
            },
            "isPaused": {
              "type": "boolean"
            },
            "variables": {
              "$ref": "#/$defs/JsonValue"
            },
            "data": {
              "$ref": "#/$defs/JsonValue"
            },
            "error": {
              "$ref": "#/$defs/JsonValue"
            },
            "failureCount": {
              "type": "integer",
              "minimum": 0
            },
            "failureReason": {
              "$ref": "#/$defs/JsonValue"
            },
            "context": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "required": [],
          "additionalProperties": false,
          "title": "MutationStateDelta"
        }
      },
      "required": ["kind", "mutationId"],
      "additionalProperties": false,
      "title": "MutationEventPayload"
    },
    "OnlineStatusPayload": {
      "type": "object",
      "properties": {
        "online": {
          "type": "boolean"
        }
      },
      "required": ["online"],
      "additionalProperties": false,
      "title": "OnlineStatusPayload"
    },
    "ActionResultPayload": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The query.action id this answers."
        },
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        }
      },
      "required": ["id", "ok"],
      "additionalProperties": false,
      "title": "ActionResultPayload"
    },
    "EmptyPayload": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false,
      "title": "EmptyPayload"
    },
    "QueryActionType": {
      "title": "QueryActionType",
      "type": "string",
      "enum": [
        "REFETCH",
        "INVALIDATE",
        "RESET",
        "REMOVE",
        "SET_QUERY_DATA",
        "TRIGGER_ERROR",
        "RESTORE_ERROR",
        "TRIGGER_LOADING",
        "RESTORE_LOADING",
        "CLEAR_QUERY_CACHE",
        "CLEAR_MUTATION_CACHE"
      ]
    },
    "QueryActionPayload": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Correlates with action.result."
        },
        "type": {
          "$ref": "#/$defs/QueryActionType"
        },
        "queryHash": {
          "type": "string",
          "description": "Required for every type except the CLEAR_* ones."
        },
        "data": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": ["id", "type"],
      "additionalProperties": false,
      "title": "QueryActionPayload"
    },
    "OnlineSetPayload": {
      "type": "object",
      "properties": {
        "online": {
          "type": "boolean"
        }
      },
      "required": ["online"],
      "additionalProperties": false,
      "title": "OnlineSetPayload"
    },
    "HelloMessage": {
      "title": "HelloMessage",
      "description": "First message the SDK sends after the socket opens.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "hello"
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id."
        },
        "payload": {
          "$ref": "#/$defs/HelloPayload"
        }
      },
      "required": ["v", "type", "payload"],
      "additionalProperties": false
    },
    "QueriesSnapshotMessage": {
      "title": "QueriesSnapshotMessage",
      "description": "Full cache contents; sent after welcome and on snapshot.request.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "queries.snapshot"
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id."
        },
        "payload": {
          "$ref": "#/$defs/QueriesSnapshotPayload"
        }
      },
      "required": ["v", "type", "payload"],
      "additionalProperties": false
    },
    "QueryEventMessage": {
      "title": "QueryEventMessage",
      "description": "One query cache change.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "query.event"
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id."
        },
        "payload": {
          "$ref": "#/$defs/QueryEventPayload"
        }
      },
      "required": ["v", "type", "payload"],
      "additionalProperties": false
    },
    "MutationEventMessage": {
      "title": "MutationEventMessage",
      "description": "One mutation cache change.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "mutation.event"
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id."
        },
        "payload": {
          "$ref": "#/$defs/MutationEventPayload"
        }
      },
      "required": ["v", "type", "payload"],
      "additionalProperties": false
    },
    "OnlineStatusMessage": {
      "title": "OnlineStatusMessage",
      "description": "onlineManager changed on the device.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "online.status"
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id."
        },
        "payload": {
          "$ref": "#/$defs/OnlineStatusPayload"
        }
      },
      "required": ["v", "type", "payload"],
      "additionalProperties": false
    },
    "ActionResultMessage": {
      "title": "ActionResultMessage",
      "description": "Outcome of a query.action.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "action.result"
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id."
        },
        "payload": {
          "$ref": "#/$defs/ActionResultPayload"
        }
      },
      "required": ["v", "type", "payload"],
      "additionalProperties": false
    },
    "PongMessage": {
      "title": "PongMessage",
      "description": "Reply to ping.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "pong"
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id."
        },
        "payload": {
          "$ref": "#/$defs/EmptyPayload"
        }
      },
      "required": ["v", "type", "payload"],
      "additionalProperties": false
    },
    "WelcomeMessage": {
      "title": "WelcomeMessage",
      "description": "Lens accepted the hello.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "welcome"
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id."
        },
        "payload": {
          "$ref": "#/$defs/WelcomePayload"
        }
      },
      "required": ["v", "type", "payload"],
      "additionalProperties": false
    },
    "SnapshotRequestMessage": {
      "title": "SnapshotRequestMessage",
      "description": "Lens asks for a fresh queries.snapshot.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "snapshot.request"
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id."
        },
        "payload": {
          "$ref": "#/$defs/EmptyPayload"
        }
      },
      "required": ["v", "type", "payload"],
      "additionalProperties": false
    },
    "QueryActionMessage": {
      "title": "QueryActionMessage",
      "description": "Lens asks the device to run a devtools action.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "query.action"
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id."
        },
        "payload": {
          "$ref": "#/$defs/QueryActionPayload"
        }
      },
      "required": ["v", "type", "payload"],
      "additionalProperties": false
    },
    "OnlineSetMessage": {
      "title": "OnlineSetMessage",
      "description": "Lens sets onlineManager on the device.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "online.set"
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id."
        },
        "payload": {
          "$ref": "#/$defs/OnlineSetPayload"
        }
      },
      "required": ["v", "type", "payload"],
      "additionalProperties": false
    },
    "PingMessage": {
      "title": "PingMessage",
      "description": "Liveness probe; the SDK answers with pong.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "ping"
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id."
        },
        "payload": {
          "$ref": "#/$defs/EmptyPayload"
        }
      },
      "required": ["v", "type", "payload"],
      "additionalProperties": false
    },
    "StorageKind": {
      "title": "StorageKind",
      "type": "string",
      "enum": ["async-storage", "mmkv", "secure-store"]
    },
    "StorageValue": {
      "title": "StorageValue",
      "type": "object",
      "description": "A stored value. Bytes travel as base64 in value.",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "number", "boolean", "bytes"]
        },
        "value": {
          "type": "string",
          "description": "The value as text: numbers and booleans in JSON form, bytes as base64."
        },
        "truncated": {
          "type": "boolean",
          "description": "The value was larger than the SDK sends (1 MiB); value is empty."
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "description": "Size in bytes of the full value."
        }
      },
      "required": ["type", "value"],
      "additionalProperties": false
    },
    "StorageKey": {
      "title": "StorageKey",
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "description": "Bytes of the value, when cheap to know."
        }
      },
      "required": ["key"],
      "additionalProperties": false
    },
    "StorageStore": {
      "title": "StorageStore",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable id the SDK chose, for example \"async-storage\" or \"mmkv:default\"."
        },
        "kind": {
          "$ref": "#/$defs/StorageKind"
        },
        "name": {
          "type": "string"
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StorageKey"
          }
        },
        "truncated": {
          "type": "boolean",
          "description": "The store has more keys than the snapshot carries (10,000)."
        },
        "live": {
          "type": "boolean",
          "description": "The SDK reports changes as they happen (MMKV); otherwise Lens refreshes."
        },
        "declaredKeys": {
          "type": "boolean",
          "description": "Only the keys the app declared are listed (SecureStore cannot enumerate)."
        }
      },
      "required": ["id", "kind", "name", "keys"],
      "additionalProperties": false
    },
    "StorageSnapshotPayload": {
      "title": "StorageSnapshotPayload",
      "type": "object",
      "properties": {
        "stores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StorageStore"
          }
        },
        "storeId": {
          "type": "string",
          "description": "Set when the snapshot replaces only this store."
        }
      },
      "required": ["stores"],
      "additionalProperties": false
    },
    "StorageEventPayload": {
      "title": "StorageEventPayload",
      "type": "object",
      "properties": {
        "storeId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": ["set", "removed", "cleared"]
        },
        "key": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["storeId", "kind"],
      "additionalProperties": false
    },
    "StorageActionType": {
      "title": "StorageActionType",
      "type": "string",
      "enum": ["GET", "SET", "REMOVE", "CLEAR", "REFRESH"]
    },
    "StorageActionPayload": {
      "title": "StorageActionPayload",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Correlates with storage.result."
        },
        "type": {
          "$ref": "#/$defs/StorageActionType"
        },
        "storeId": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/StorageValue"
        }
      },
      "required": ["id", "type", "storeId"],
      "additionalProperties": false
    },
    "StorageResultPayload": {
      "title": "StorageResultPayload",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The storage.action id this answers."
        },
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/StorageValue",
          "description": "The value, for GET."
        }
      },
      "required": ["id", "ok"],
      "additionalProperties": false
    },
    "StorageSnapshotMessage": {
      "title": "StorageSnapshotMessage",
      "description": "The app's storage stores and their keys (values are fetched on demand).",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "storage.snapshot"
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id."
        },
        "payload": {
          "$ref": "#/$defs/StorageSnapshotPayload"
        }
      },
      "required": ["v", "type", "payload"],
      "additionalProperties": false
    },
    "StorageEventMessage": {
      "title": "StorageEventMessage",
      "description": "A key changed in a live store (MMKV).",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "storage.event"
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id."
        },
        "payload": {
          "$ref": "#/$defs/StorageEventPayload"
        }
      },
      "required": ["v", "type", "payload"],
      "additionalProperties": false
    },
    "StorageActionMessage": {
      "title": "StorageActionMessage",
      "description": "Lens asks the SDK to read or change a store.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "storage.action"
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id."
        },
        "payload": {
          "$ref": "#/$defs/StorageActionPayload"
        }
      },
      "required": ["v", "type", "payload"],
      "additionalProperties": false
    },
    "StorageResultMessage": {
      "title": "StorageResultMessage",
      "description": "Outcome of a storage.action.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "storage.result"
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id."
        },
        "payload": {
          "$ref": "#/$defs/StorageResultPayload"
        }
      },
      "required": ["v", "type", "payload"],
      "additionalProperties": false
    },
    "PluginId": {
      "title": "PluginId",
      "description": "Stable plugin identifier, unique per app: lowercase letters, digits, '.', '_' or '-'.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "PluginRegisterPayload": {
      "title": "PluginRegisterPayload",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/PluginId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Shown as the panel's tab."
        },
        "description": {
          "type": "string",
          "maxLength": 280
        },
        "version": {
          "type": "string",
          "maxLength": 32
        }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "PluginAction": {
      "title": "PluginAction",
      "description": "A button. Clicking it sends plugin.action to the app.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "destructive": {
          "type": "boolean",
          "description": "Shown in the destructive style."
        },
        "confirm": {
          "type": "string",
          "maxLength": 280,
          "description": "Lens asks the user to confirm this text before sending the action."
        }
      },
      "required": ["id", "label"],
      "additionalProperties": false
    },
    "PluginTextBlock": {
      "title": "PluginTextBlock",
      "type": "object",
      "properties": {
        "type": {
          "const": "text"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "maxLength": 4096
        },
        "tone": {
          "enum": ["default", "muted", "warning", "error"]
        }
      },
      "required": ["type", "id", "text"],
      "additionalProperties": false
    },
    "PluginKeyValueBlock": {
      "title": "PluginKeyValueBlock",
      "type": "object",
      "properties": {
        "type": {
          "const": "keyValue"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 128
        },
        "items": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "title": "PluginKeyValueItem",
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "label": {
                "type": "string",
                "maxLength": 128
              },
              "value": {
                "$ref": "#/$defs/JsonValue"
              }
            },
            "required": ["key", "value"],
            "additionalProperties": false
          }
        }
      },
      "required": ["type", "id", "items"],
      "additionalProperties": false
    },
    "PluginTableBlock": {
      "title": "PluginTableBlock",
      "type": "object",
      "properties": {
        "type": {
          "const": "table"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 128
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "title": "PluginTableColumn",
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "label": {
                "type": "string",
                "maxLength": 64
              }
            },
            "required": ["key", "label"],
            "additionalProperties": false
          }
        },
        "rows": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "title": "PluginTableRow",
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "cells": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/JsonValue"
                },
                "description": "Values by column key; missing keys show as empty."
              }
            },
            "required": ["id", "cells"],
            "additionalProperties": false
          }
        },
        "rowActions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/PluginAction"
          },
          "description": "Buttons on every row; the action carries the row id."
        }
      },
      "required": ["type", "id", "columns", "rows"],
      "additionalProperties": false
    },
    "PluginJsonBlock": {
      "title": "PluginJsonBlock",
      "type": "object",
      "properties": {
        "type": {
          "const": "json"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 128
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": ["type", "id", "value"],
      "additionalProperties": false
    },
    "PluginLogBlock": {
      "title": "PluginLogBlock",
      "description": "Newest entry last.",
      "type": "object",
      "properties": {
        "type": {
          "const": "log"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 128
        },
        "entries": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "title": "PluginLogEntry",
            "type": "object",
            "properties": {
              "time": {
                "type": "string",
                "description": "ISO 8601 time."
              },
              "level": {
                "enum": ["debug", "info", "warn", "error"]
              },
              "text": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "required": ["text"],
            "additionalProperties": false
          }
        }
      },
      "required": ["type", "id", "entries"],
      "additionalProperties": false
    },
    "PluginActionsBlock": {
      "title": "PluginActionsBlock",
      "type": "object",
      "properties": {
        "type": {
          "const": "actions"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 128
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/PluginAction"
          }
        }
      },
      "required": ["type", "id", "actions"],
      "additionalProperties": false
    },
    "PluginBlock": {
      "title": "PluginBlock",
      "description": "One piece of a plugin's panel. Lens draws each kind with its own components.",
      "oneOf": [
        {
          "$ref": "#/$defs/PluginTextBlock"
        },
        {
          "$ref": "#/$defs/PluginKeyValueBlock"
        },
        {
          "$ref": "#/$defs/PluginTableBlock"
        },
        {
          "$ref": "#/$defs/PluginJsonBlock"
        },
        {
          "$ref": "#/$defs/PluginLogBlock"
        },
        {
          "$ref": "#/$defs/PluginActionsBlock"
        }
      ]
    },
    "PluginViewPayload": {
      "title": "PluginViewPayload",
      "type": "object",
      "properties": {
        "pluginId": {
          "$ref": "#/$defs/PluginId"
        },
        "blocks": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/PluginBlock"
          },
          "description": "The whole panel, top to bottom. Each plugin.view replaces the previous one."
        }
      },
      "required": ["pluginId", "blocks"],
      "additionalProperties": false
    },
    "PluginActionPayload": {
      "title": "PluginActionPayload",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Correlates with plugin.result."
        },
        "pluginId": {
          "$ref": "#/$defs/PluginId"
        },
        "blockId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "rowId": {
          "type": "string",
          "description": "The row, for a table row action."
        }
      },
      "required": ["id", "pluginId", "blockId", "actionId"],
      "additionalProperties": false
    },
    "PluginResultPayload": {
      "title": "PluginResultPayload",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The plugin.action id this answers."
        },
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "maxLength": 280,
          "description": "Shown to the user after a successful action."
        }
      },
      "required": ["id", "ok"],
      "additionalProperties": false
    },
    "PluginRegisterMessage": {
      "title": "PluginRegisterMessage",
      "description": "The app declares a plugin; Lens shows it as a tab of the Plugins panel.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "plugin.register"
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id."
        },
        "payload": {
          "$ref": "#/$defs/PluginRegisterPayload"
        }
      },
      "required": ["v", "type", "payload"],
      "additionalProperties": false
    },
    "PluginViewMessage": {
      "title": "PluginViewMessage",
      "description": "The plugin's whole panel, replacing the previous view.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "plugin.view"
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id."
        },
        "payload": {
          "$ref": "#/$defs/PluginViewPayload"
        }
      },
      "required": ["v", "type", "payload"],
      "additionalProperties": false
    },
    "PluginActionMessage": {
      "title": "PluginActionMessage",
      "description": "The user clicked a plugin action in Lens.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "plugin.action"
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id."
        },
        "payload": {
          "$ref": "#/$defs/PluginActionPayload"
        }
      },
      "required": ["v", "type", "payload"],
      "additionalProperties": false
    },
    "PluginResultMessage": {
      "title": "PluginResultMessage",
      "description": "Outcome of a plugin.action.",
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "plugin.result"
        },
        "id": {
          "type": "string",
          "description": "Optional correlation id."
        },
        "payload": {
          "$ref": "#/$defs/PluginResultPayload"
        }
      },
      "required": ["v", "type", "payload"],
      "additionalProperties": false
    }
  }
}
